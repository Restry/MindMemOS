# Copy this file to dockers-lite/.env to override local development defaults.

# pgvector image and host port
PGVECTOR_IMAGE_TAG=0.8.2-pg17-bookworm
MINDMEMOS_LITE_PGVECTOR_PORT=5432

# Local PostgreSQL bootstrap credentials
MINDMEMOS_LITE_POSTGRES_DB=mindmemos
MINDMEMOS_LITE_POSTGRES_USER=postgres
MINDMEMOS_LITE_POSTGRES_PASSWORD=postgres

# Consumed by MindMemOS Lite, not by the PostgreSQL container itself.
PGVECTOR_DSN=postgresql://postgres:postgres@127.0.0.1:5432/mindmemos
